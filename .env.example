# Training Studio settings. Copy to `.env` (same folder as studio.bat) and edit:
#     copy .env.example .env        (Linux/macOS: cp .env.example .env)
# Read by studio.bat / studio.sh, backend/app/config.py and frontend/vite.config.js.
# Variables already set in the environment win over this file.
# Format: KEY=VALUE, one per line, no quotes, comments on their own line.
# Empty or missing = default. Relative paths are taken from this folder (training-management-server/).

# ---------------------------------------------------------------- web server
# 127.0.0.1 = this machine only. The app has NO login: use 0.0.0.0 only on a trusted network.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8700
# Python venv for the backend (default backend/.venv). On Windows keep it short, e.g. C:\studio-venv (pyarrow + 260-char limit).
STUDIO_VENV=
# SQLite database (default backend/data/studio.db)
STUDIO_DB=
# Built frontend (default frontend/dist)
STUDIO_FRONTEND_DIST=

# Frontend dev server (npm run dev): its port, and the API it proxies /api to (default http://STUDIO_HOST:STUDIO_PORT)
STUDIO_DEV_PORT=5175
STUDIO_API_URL=

# ---------------------------------------------------------------- data folders (defaults: inside this folder)
# Robot description folder: <design>/<design_dir>/ holds each robot's URDF/USD (default design, inside this folder).
# Example when the design files live elsewhere: STUDIO_DESIGN_DIR=D:\robots\design   or   STUDIO_DESIGN_DIR=../design
STUDIO_DESIGN_DIR=
# Isaac Sim install, the folder with python.bat / python.sh (default: $ISAAC_SIM_DIR, else isaacsim inside this folder)
STUDIO_ISAAC_SIM_DIR=
# Python that can import isaacsim (default <STUDIO_ISAAC_SIM_DIR>/python.bat). With setup_train_env.bat: the venv's python.
STUDIO_ISAAC_SIM_PYTHON=
# LeRobot datasets (default datasets/lerobot)
STUDIO_DATASETS_DIR=
# Training runs / checkpoints (default outputs)
STUDIO_OUTPUTS_DIR=
# Eval + train summaries *.json (default results)
STUDIO_RESULTS_DIR=
# Logs; job logs go to <logs>/studio (default logs)
STUDIO_LOGS_DIR=
# Base models (default models)
STUDIO_MODELS_DIR=
# Humanoid body spec (default scripts/data/humanoid.json)
STUDIO_HUMANOID_JSON=

# ---------------------------------------------------------------- training env install (setup_train_env.bat / .sh)
# studio.bat / studio.sh check the training Python on every start and install what is missing (torch, isaacsim, lerobot).
# Target: STUDIO_TRAIN_PYTHON if set, else the venv STUDIO_TRAIN_ENV. 0 = only check, never install.
STUDIO_AUTO_SETUP_TRAIN_ENV=1
# venv with torch + isaacsim + lerobot (default env_isaacsim). Windows: keep it SHORT, e.g. C:\mhh_env
STUDIO_TRAIN_ENV=
# torch wheel index: cu128 (CUDA 12) or https://download.pytorch.org/whl/cu130 (CUDA 13)
STUDIO_TORCH_INDEX=https://download.pytorch.org/whl/cu128
STUDIO_TORCH_VERSION=2.11.0
STUDIO_TORCHVISION_VERSION=0.26.0
STUDIO_ISAACSIM_VERSION=6.0.1.0

# ---------------------------------------------------------------- training jobs (only where the training env exists)
# Python of the training env with lerobot installed. Default env/python.exe (Windows) or env/bin/python (Linux).
# Leave it pointing at a missing file to run the app as a viewer only.
STUDIO_TRAIN_PYTHON=
# Hugging Face cache (default <models>/hf_home) and offline mode
STUDIO_HF_HOME=
STUDIO_HF_HUB_OFFLINE=1
# Dataset cache: keep the path SHORT on Windows (WinError 206). Default <drive of this folder>\hfds
STUDIO_HF_DATASETS_CACHE=
# SmolVLA base checkpoints by state dimension (defaults <models>/smolvla_base_humanoid and <models>/smolvla_base_yellowarm)
STUDIO_SMOLVLA_BASE_16D=
STUDIO_SMOLVLA_BASE_8D=
# Device passed to lerobot (cuda / cpu)
STUDIO_POLICY_DEVICE=cuda
# Refuse to start a job when the GPU has less free memory than this (GiB)
STUDIO_GPU_MIN_FREE_GIB=4
# DataLoader workers for lerobot_train
STUDIO_TRAIN_NUM_WORKERS=4
# Upper limits accepted by the Jobs form
STUDIO_TRAIN_MAX_STEPS=200000
STUDIO_TRAIN_MAX_BATCH=64
